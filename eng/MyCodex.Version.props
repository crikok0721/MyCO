<Project>
  <PropertyGroup>
    <MyCodexVersion>0.2.0-alpha.5</MyCodexVersion>
    <MyCodexProtocolVersion>1</MyCodexProtocolVersion>
    <MyCodexConfigSchemaVersion>2</MyCodexConfigSchemaVersion>
    <MyCodexCalibrationSchemaVersion>1</MyCodexCalibrationSchemaVersion>

    <Version>$(MyCodexVersion)</Version>
    <PackageVersion>$(MyCodexVersion)</PackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="MyCodexProtocolVersion"
                      Value="$(MyCodexProtocolVersion)" />
    <AssemblyMetadata Include="MyCodexConfigSchemaVersion"
                      Value="$(MyCodexConfigSchemaVersion)" />
    <AssemblyMetadata Include="MyCodexCalibrationSchemaVersion"
                      Value="$(MyCodexCalibrationSchemaVersion)" />
  </ItemGroup>
</Project>
