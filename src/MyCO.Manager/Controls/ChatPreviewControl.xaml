<!-- Shared preview used by Home and Appearance. It has one theme state and no nested scrolling. -->
<UserControl x:Class="MyCO.Manager.Controls.ChatPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MyCO.Manager.Controls"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <local:PreviewEffectiveAvatarSizeConverter x:Key="PreviewEffectiveAvatarSizeConverter" />
        <local:PreviewEffectiveAvatarVerticalOffsetConverter x:Key="PreviewEffectiveAvatarVerticalOffsetConverter" />
        <local:PreviewEffectiveUserAvatarVerticalOffsetConverter x:Key="PreviewEffectiveUserAvatarVerticalOffsetConverter" />
        <local:PreviewUserHorizontalOffsetConverter x:Key="PreviewUserHorizontalOffsetConverter" />
        <local:PreviewEffectiveRadiusConverter x:Key="PreviewEffectiveRadiusConverter" />
        <local:PreviewNicknameBubbleMarginConverter x:Key="PreviewNicknameBubbleMarginConverter" />
        <!-- Both roles share one geometry algorithm; their semantic brushes remain distinct. -->
        <Style x:Key="PreviewBubbleStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius"
                    Value="{Binding BubbleRadius,
                        Converter={StaticResource PreviewEffectiveRadiusConverter}}" />
            <Setter Property="Padding"
                    Value="{Binding PreviewBubblePadding,
                        RelativeSource={RelativeSource AncestorType={x:Type local:ChatPreviewControl}}}" />
            <Setter Property="MaxWidth" Value="480" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>
    <Border Background="{Binding PreviewBackground}"
            BorderThickness="0"
            CornerRadius="{StaticResource RadiusFloating}"
            Padding="24">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#42554D"
                                          BlurRadius="22"
                                          ShadowDepth="5"
                                          Opacity=".08" />
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDarkCodexPreview}" Value="True">
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="#050403"
                                                  BlurRadius="26"
                                                  ShadowDepth="6"
                                                  Opacity=".22" />
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ComboBox Grid.Row="0"
                      x:Name="CodexPreviewThemeSelector"
                      Width="190"
                      MinHeight="36"
                      HorizontalAlignment="Right"
                      ItemsSource="{Binding CodexPreviewThemeOptions}"
                      SelectedItem="{Binding SelectedCodexPreviewThemeOption}"
                      ToolTip="{DynamicResource PreviewThemeSelectorHint}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="{DynamicResource PrimaryBrush}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0" />
                            <TextBlock Text="{Binding DisplayName}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <!-- Assistant identity and one themed message. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="{Binding AvatarSize, Converter={StaticResource PreviewEffectiveAvatarSizeConverter}}"
                          Height="{Binding AvatarSize, Converter={StaticResource PreviewEffectiveAvatarSizeConverter}}"
                          MinWidth="24"
                          MinHeight="24"
                          MaxWidth="72"
                          MaxHeight="72"
                          VerticalAlignment="Top">
                        <Grid.RenderTransform>
                            <TranslateTransform X="{Binding AssistantAvatarOffsetX}"
                                                Y="{Binding AssistantAvatarOffsetY,
                                                    Converter={StaticResource PreviewEffectiveAvatarVerticalOffsetConverter}}" />
                        </Grid.RenderTransform>
                        <Ellipse Fill="{Binding PreviewAvatarBackground}" />
                        <Ellipse Stroke="{Binding PreviewAvatarBorder}"
                                 StrokeThickness="1">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding AssistantAvatar}"
                                            Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                    <StackPanel Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Top">
                        <Grid MinHeight="22">
                            <TextBlock Text="{Binding AssistantName}"
                                       Foreground="{Binding PreviewNicknameColor}"
                                       FontSize="13"
                                       LineHeight="18"
                                       LineStackingStrategy="BlockLineHeight"
                                       MaxWidth="360"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Left"
                                       Visibility="{Binding NicknameVisible,
                                           Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform X="{Binding AssistantNicknameOffsetX}"
                                                        Y="{Binding AssistantNicknameOffsetY}" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                        <Border x:Name="AssistantPreviewBubble"
                                Background="{Binding PreviewAssistantBubble}"
                                Style="{StaticResource PreviewBubbleStyle}"
                                Margin="{Binding AssistantNicknameOffsetY,
                                    Converter={StaticResource PreviewNicknameBubbleMarginConverter}}"
                                MaxWidth="{Binding PreviewAssistantBubbleMaxWidth,
                                    RelativeSource={RelativeSource AncestorType={x:Type local:ChatPreviewControl}}}">
                            <TextBlock Text="{DynamicResource PreviewAssistantMessage}"
                                       Foreground="{Binding PreviewAssistantText}"
                                       TextWrapping="Wrap"
                                       LineHeight="21" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- User identity and one message from the same selected Codex theme. -->
                <Grid Margin="{Binding PreviewMessageGap,
                                  RelativeSource={RelativeSource AncestorType={x:Type local:ChatPreviewControl}}}"
                      HorizontalAlignment="Right">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel HorizontalAlignment="Right"
                                Margin="0,0,12,0"
                                VerticalAlignment="Top">
                        <Grid MinHeight="22">
                            <TextBlock Text="{Binding UserName}"
                                       TextAlignment="Right"
                                       Foreground="{Binding PreviewNicknameColor}"
                                       FontSize="13"
                                       LineHeight="18"
                                       LineStackingStrategy="BlockLineHeight"
                                       MaxWidth="360"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Right"
                                       Visibility="{Binding NicknameVisible,
                                           Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform X="{Binding UserNicknameOffsetX,
                                        Converter={StaticResource PreviewUserHorizontalOffsetConverter}}"
                                                        Y="{Binding UserNicknameOffsetY}" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                        <Border x:Name="UserPreviewBubble"
                                Background="{Binding PreviewUserBubble}"
                                Style="{StaticResource PreviewBubbleStyle}"
                                Margin="{Binding UserNicknameOffsetY,
                                    Converter={StaticResource PreviewNicknameBubbleMarginConverter}}"
                                HorizontalAlignment="Right">
                            <TextBlock Text="{DynamicResource PreviewUserMessage}"
                                       Foreground="{Binding PreviewUserText}"
                                       TextWrapping="Wrap"
                                       LineHeight="21" />
                        </Border>
                    </StackPanel>
                    <Grid Grid.Column="1"
                          Width="{Binding AvatarSize, Converter={StaticResource PreviewEffectiveAvatarSizeConverter}}"
                          Height="{Binding AvatarSize, Converter={StaticResource PreviewEffectiveAvatarSizeConverter}}"
                          MinWidth="24"
                          MinHeight="24"
                          MaxWidth="72"
                          MaxHeight="72">
                        <Grid.RenderTransform>
                            <TranslateTransform X="{Binding UserAvatarOffsetX,
                                Converter={StaticResource PreviewUserHorizontalOffsetConverter}}"
                                                Y="{Binding UserAvatarOffsetY,
                                                    Converter={StaticResource PreviewEffectiveUserAvatarVerticalOffsetConverter}}" />
                        </Grid.RenderTransform>
                        <Ellipse Fill="{Binding PreviewAvatarBackground}" />
                        <Ellipse Stroke="{Binding PreviewAvatarBorder}"
                                 StrokeThickness="1">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding UserAvatar}"
                                            Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
