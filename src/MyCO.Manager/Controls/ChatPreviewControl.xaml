<!-- Shared preview used by Home and Appearance. It has one theme state and no nested scrolling. -->
<UserControl x:Class="MyCO.Manager.Controls.ChatPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MyCO.Manager.Controls"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <!-- Both roles share one geometry algorithm; their semantic brushes remain distinct. -->
        <Style x:Key="PreviewBubbleStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{Binding BubbleRadius}" />
            <Setter Property="Padding"
                    Value="{Binding PreviewBubblePadding,
                        RelativeSource={RelativeSource AncestorType={x:Type local:ChatPreviewControl}}}" />
            <Setter Property="MaxWidth" Value="480" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>
    <Border Background="{Binding PreviewBackground}"
            BorderThickness="0"
            CornerRadius="{StaticResource RadiusFloating}"
            Padding="24">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#42554D"
                                          BlurRadius="22"
                                          ShadowDepth="5"
                                          Opacity=".08" />
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDarkCodexPreview}" Value="True">
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="#050403"
                                                  BlurRadius="26"
                                                  ShadowDepth="6"
                                                  Opacity=".22" />
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ComboBox Grid.Row="0"
                      x:Name="CodexPreviewThemeSelector"
                      Width="190"
                      MinHeight="36"
                      HorizontalAlignment="Right"
                      ItemsSource="{Binding CodexPreviewThemeOptions}"
                      SelectedItem="{Binding SelectedCodexPreviewThemeOption}"
                      ToolTip="{DynamicResource PreviewThemeSelectorHint}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="{DynamicResource PrimaryBrush}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0" />
                            <TextBlock Text="{Binding DisplayName}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <!-- Assistant identity and one themed message. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="{Binding AvatarSize}"
                          Height="{Binding AvatarSize}"
                          MinWidth="34"
                          MinHeight="34"
                          MaxWidth="54"
                          MaxHeight="54"
                          VerticalAlignment="Top">
                        <Grid.RenderTransform>
                            <TranslateTransform X="{Binding AssistantAvatarOffsetX}"
                                                Y="{Binding AssistantAvatarOffsetY}" />
                        </Grid.RenderTransform>
                        <Ellipse Fill="{Binding PreviewAvatarBackground}" />
                        <Ellipse Stroke="{Binding PreviewAvatarBorder}"
                                 StrokeThickness="1">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding AssistantAvatar}"
                                            Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                    <StackPanel Grid.Column="1"
                                Margin="12,-2,0,0">
                        <Grid Height="48"
                              Visibility="{Binding NicknameVisible,
                                  Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding AssistantName}"
                                       Foreground="{Binding PreviewNicknameColor}"
                                       FontSize="13"
                                       MaxWidth="360"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Margin="2,0,0,0">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform X="{Binding AssistantNicknameOffsetX}"
                                                        Y="{Binding AssistantNicknameOffsetY}" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                        <Border x:Name="AssistantPreviewBubble"
                                Background="{Binding PreviewUserBubble}"
                                Style="{StaticResource PreviewBubbleStyle}"
                                MaxWidth="{Binding PreviewAssistantBubbleMaxWidth,
                                    RelativeSource={RelativeSource AncestorType={x:Type local:ChatPreviewControl}}}">
                            <TextBlock Text="{DynamicResource PreviewAssistantMessage}"
                                       Foreground="{Binding PreviewUserText}"
                                       TextWrapping="Wrap"
                                       LineHeight="21" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- User identity and one message from the same selected Codex theme. -->
                <Grid Margin="{Binding PreviewMessageGap,
                                  RelativeSource={RelativeSource AncestorType={x:Type local:ChatPreviewControl}}}"
                      HorizontalAlignment="Right">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel HorizontalAlignment="Right"
                                Margin="0,-2,12,0">
                        <Grid Height="48"
                              Visibility="{Binding NicknameVisible,
                                  Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding UserName}"
                                       TextAlignment="Right"
                                       Foreground="{Binding PreviewNicknameColor}"
                                       FontSize="13"
                                       MaxWidth="360"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Margin="0,0,2,0">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform X="{Binding UserNicknameOffsetX}"
                                                        Y="{Binding UserNicknameOffsetY}" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                        <Border x:Name="UserPreviewBubble"
                                Background="{Binding PreviewUserBubble}"
                                Style="{StaticResource PreviewBubbleStyle}"
                                HorizontalAlignment="Right">
                            <TextBlock Text="{DynamicResource PreviewUserMessage}"
                                       Foreground="{Binding PreviewUserText}"
                                       TextWrapping="Wrap"
                                       LineHeight="21" />
                        </Border>
                    </StackPanel>
                    <Grid Grid.Column="1"
                          Width="{Binding AvatarSize}"
                          Height="{Binding AvatarSize}"
                          MinWidth="34"
                          MinHeight="34"
                          MaxWidth="54"
                          MaxHeight="54">
                        <Grid.RenderTransform>
                            <TranslateTransform X="{Binding UserAvatarOffsetX}"
                                                Y="{Binding UserAvatarOffsetY}" />
                        </Grid.RenderTransform>
                        <Ellipse Fill="{Binding PreviewAvatarBackground}" />
                        <Ellipse Stroke="{Binding PreviewAvatarBorder}"
                                 StrokeThickness="1">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding UserAvatar}"
                                            Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
