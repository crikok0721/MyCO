    <sys:String x:Key="AboutTitle">About MyCO</sys:String>
    <sys:String x:Key="AboutSubtitle">Independent local UI customization for Codex / ChatGPT Desktop</sys:String>
    <sys:String x:Key="AboutTagline">It's MyCO!!!!!</sys:String>
    <sys:String x:Key="PrivacyByConstruction">Privacy by construction</sys:String>
    <sys:String x:Key="PrivacyParagraphOne">MyCO runs locally. It does not upload conversations, require OpenAI credentials, collect telemetry, read authentication cookies, intercept network requests, or expose shell/file privileges to injected JavaScript.</sys:String>
    <sys:String x:Key="PrivacyParagraphTwo">Configuration, avatar copies, structural calibration signatures, backups, and privacy-safe logs are stored under %APPDATA%\MyCO.</sys:String>
    <sys:String x:Key="OpenConfigFolder">Open local configuration folder</sys:String>
    <sys:String x:Key="CompatibilityTitle">Compatibility</sys:String>
    <sys:String x:Key="CompatibilityParagraph">Automatic capability detection handles small changes. Recalibration handles structural changes. Major renderer or CDP changes may require a new MyCO release. Compatibility with every future update is not guaranteed.</sys:String>
    <sys:String x:Key="LicenseDisclaimer">License &amp; disclaimer</sys:String>
    <sys:String x:Key="LicenseCopyright">MIT License · Copyright © 2026 Crikok</sys:String>
    <sys:String x:Key="DisclaimerParagraph">MyCO is an independent open-source project. It is not affiliated with, endorsed by, or sponsored by OpenAI. An official Codex / ChatGPT Desktop installation is required.</sys:String>

