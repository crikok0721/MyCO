<!-- MyCO dark theme: warm near-black neutrals with quiet, clear mint accents. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Semantic surfaces -->
    <SolidColorBrush x:Key="WindowBrush" Color="#141210" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#181512" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#191613" />
    <SolidColorBrush x:Key="StatusBarBrush" Color="#12100E" />
    <SolidColorBrush x:Key="PanelBrush" Color="#211E1B" />
    <SolidColorBrush x:Key="PanelSubtleBrush" Color="#1C1916" />
    <SolidColorBrush x:Key="PanelHoverBrush" Color="#2B2723" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#35302B" />
    <SolidColorBrush x:Key="SurfaceFloatingBrush" Color="#27231F" />
    <SolidColorBrush x:Key="GlassSurfaceBrush" Color="#EC211D1A" />
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#820A0908" />

    <!-- Semantic borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="#332E2A" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#4B423B" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#403832" />

    <!-- Accent -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#79DAB7" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#8AE2C2" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#63C8A5" />
    <SolidColorBrush x:Key="PrimaryMutedBrush" Color="#22362E" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#99E6C9" />
    <SolidColorBrush x:Key="AccentSurfaceHoverBrush" Color="#294439" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#3E765F" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#102B22" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#2E79DAB7" />

    <!-- Typography -->
    <SolidColorBrush x:Key="TextBrush" Color="#F2EEEA" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#C9C1BA" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9B928B" />

    <!-- Controls and selection -->
    <SolidColorBrush x:Key="ControlBrush" Color="#1B1815" />
    <SolidColorBrush x:Key="ControlTextBrush" Color="#F2EEEA" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#2C2723" />
    <SolidColorBrush x:Key="ControlDisabledBrush" Color="#27221F" />
    <SolidColorBrush x:Key="FocusBrush" Color="#79DAB7" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#315D4B" />
    <SolidColorBrush x:Key="SelectionTextBrush" Color="#F4FFF9" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#243A32" />
    <SolidColorBrush x:Key="NavSelectedTextBrush" Color="#A8EBD2" />

    <!-- State colors -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#69C296" />
    <SolidColorBrush x:Key="SuccessPanelBrush" Color="#1E2A24" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#355542" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#9ED6B8" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D0A15B" />
    <SolidColorBrush x:Key="WarningPanelBrush" Color="#2D261C" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#59472D" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#E2C58F" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#D57A84" />
    <SolidColorBrush x:Key="ErrorPanelBrush" Color="#302023" />
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#62363C" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#E8A5AC" />

    <!-- Preview and protected native surfaces -->
    <SolidColorBrush x:Key="PreviewBrush" Color="#181513" />
    <SolidColorBrush x:Key="AvatarPlaceholderBrush" Color="#37302B" />
    <SolidColorBrush x:Key="NativeUserBubbleBrush" Color="#2B2724" />
    <SolidColorBrush x:Key="NativeUserTextBrush" Color="#F4F0EC" />
    <SolidColorBrush x:Key="ToolPanelBrush" Color="#171412" />
    <SolidColorBrush x:Key="ToolBorderBrush" Color="#403833" />
    <SolidColorBrush x:Key="ToolTextBrush" Color="#B8AEA7" />
    <SolidColorBrush x:Key="CodeSurfaceBrush" Color="#101311" />
    <SolidColorBrush x:Key="CodeTextBrush" Color="#CDEBDD" />

    <!-- Elevation -->
    <DropShadowEffect x:Key="CardShadowEffect"
                      Color="#050403" BlurRadius="30" ShadowDepth="8" Opacity=".24" />
    <DropShadowEffect x:Key="FloatingShadowEffect"
                      Color="#050403" BlurRadius="44" ShadowDepth="14" Opacity=".34" />
    <DropShadowEffect x:Key="AccentShadowEffect"
                      Color="#54B995" BlurRadius="20" ShadowDepth="4" Opacity=".11" />
    <DropShadowEffect x:Key="PopupShadowEffect"
                      Color="#050403" BlurRadius="32" ShadowDepth="9" Opacity=".38" />

    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#315D4B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F4FFF9" />
</ResourceDictionary>
