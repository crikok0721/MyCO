<!-- MyCO light theme: quiet neutral surfaces with restrained mint accents. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Semantic surfaces -->
    <SolidColorBrush x:Key="WindowBrush" Color="#F1F3F2" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#F8FAF9" />
    <SolidColorBrush x:Key="TitleBarBrush" Color="#FBFCFB" />
    <SolidColorBrush x:Key="StatusBarBrush" Color="#F7F9F8" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FCFDFC" />
    <SolidColorBrush x:Key="PanelSubtleBrush" Color="#F2F5F3" />
    <SolidColorBrush x:Key="PanelHoverBrush" Color="#EAF0ED" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#E2EAE6" />
    <SolidColorBrush x:Key="SurfaceFloatingBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="GlassSurfaceBrush" Color="#EFFFFFFF" />
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#B8FFFFFF" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#520F1714" />

    <!-- Semantic borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E8E5" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#CBD5D0" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#D3DDD8" />

    <!-- Accent -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#61C9A4" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#54BA97" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#46A783" />
    <SolidColorBrush x:Key="PrimaryMutedBrush" Color="#EAF8F2" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#236B55" />
    <SolidColorBrush x:Key="AccentSurfaceHoverBrush" Color="#DDF4EA" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#AEE0CC" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#143A2E" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#347EDDB8" />

    <!-- Typography -->
    <SolidColorBrush x:Key="TextBrush" Color="#1F2623" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#4F5B56" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#69746F" />

    <!-- Controls and selection -->
    <SolidColorBrush x:Key="ControlBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlTextBrush" Color="#1F2623" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#F0F4F2" />
    <SolidColorBrush x:Key="ControlDisabledBrush" Color="#EDF1EF" />
    <SolidColorBrush x:Key="FocusBrush" Color="#4CB58F" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#CDEFE1" />
    <SolidColorBrush x:Key="SelectionTextBrush" Color="#16382D" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#E5F6EF" />
    <SolidColorBrush x:Key="NavSelectedTextBrush" Color="#205F4C" />

    <!-- State colors -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#3D8F6C" />
    <SolidColorBrush x:Key="SuccessPanelBrush" Color="#EEF8F3" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#C4E4D5" />
    <SolidColorBrush x:Key="SuccessTextBrush" Color="#326A54" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B28345" />
    <SolidColorBrush x:Key="WarningPanelBrush" Color="#FBF6EC" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#E8D7B7" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#785A30" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#B9606C" />
    <SolidColorBrush x:Key="ErrorPanelBrush" Color="#FCF1F3" />
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#EAC5CB" />
    <SolidColorBrush x:Key="ErrorTextBrush" Color="#87444D" />

    <!-- Preview and protected native surfaces -->
    <SolidColorBrush x:Key="PreviewBrush" Color="#F1F5F3" />
    <SolidColorBrush x:Key="AvatarPlaceholderBrush" Color="#DFE7E3" />
    <SolidColorBrush x:Key="NativeUserBubbleBrush" Color="#E9EEEB" />
    <SolidColorBrush x:Key="NativeUserTextBrush" Color="#222A26" />
    <SolidColorBrush x:Key="ToolPanelBrush" Color="#FBFCFC" />
    <SolidColorBrush x:Key="ToolBorderBrush" Color="#D7DFDC" />
    <SolidColorBrush x:Key="ToolTextBrush" Color="#4F5A55" />
    <SolidColorBrush x:Key="CodeSurfaceBrush" Color="#202722" />
    <SolidColorBrush x:Key="CodeTextBrush" Color="#DFF4EA" />

    <!-- Elevation -->
    <DropShadowEffect x:Key="CardShadowEffect"
                      Color="#42554D" BlurRadius="28" ShadowDepth="7" Opacity=".08" />
    <DropShadowEffect x:Key="FloatingShadowEffect"
                      Color="#34473F" BlurRadius="42" ShadowDepth="12" Opacity=".14" />
    <DropShadowEffect x:Key="AccentShadowEffect"
                      Color="#3A9E7B" BlurRadius="20" ShadowDepth="4" Opacity=".13" />
    <DropShadowEffect x:Key="PopupShadowEffect"
                      Color="#283A33" BlurRadius="30" ShadowDepth="8" Opacity=".16" />

    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#CDEFE1" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#16382D" />
</ResourceDictionary>
