<!--
    MyCO primitive design tokens.
    Theme-specific meaning belongs in Theme.Light.xaml / Theme.Dark.xaml;
    controls consume only semantic or component resources from those dictionaries.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Mint primitive scale -->
    <Color x:Key="Mint50Color">#F1FCF7</Color>
    <Color x:Key="Mint100Color">#DCF7EC</Color>
    <Color x:Key="Mint200Color">#BDEEDB</Color>
    <Color x:Key="Mint300Color">#98E4C8</Color>
    <Color x:Key="Mint400Color">#7AD9B5</Color>
    <Color x:Key="Mint500Color">#61C9A4</Color>
    <Color x:Key="Mint600Color">#46AD89</Color>
    <Color x:Key="Mint700Color">#35846A</Color>

    <SolidColorBrush x:Key="Mint50Brush" Color="{StaticResource Mint50Color}" />
    <SolidColorBrush x:Key="Mint100Brush" Color="{StaticResource Mint100Color}" />
    <SolidColorBrush x:Key="Mint200Brush" Color="{StaticResource Mint200Color}" />
    <SolidColorBrush x:Key="Mint300Brush" Color="{StaticResource Mint300Color}" />
    <SolidColorBrush x:Key="Mint400Brush" Color="{StaticResource Mint400Color}" />
    <SolidColorBrush x:Key="Mint500Brush" Color="{StaticResource Mint500Color}" />
    <SolidColorBrush x:Key="Mint600Brush" Color="{StaticResource Mint600Color}" />
    <SolidColorBrush x:Key="Mint700Brush" Color="{StaticResource Mint700Color}" />

    <!-- Typography -->
    <FontFamily x:Key="UiFontFamily">Segoe UI Variable Text, Segoe UI, Yu Gothic UI, Meiryo UI, Microsoft YaHei UI, Microsoft JhengHei UI</FontFamily>
    <FontFamily x:Key="CodeFontFamily">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="FontSizeCaption">11</sys:Double>
    <sys:Double x:Key="FontSizeLabel">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeSection">17</sys:Double>
    <sys:Double x:Key="FontSizePageTitle">24</sys:Double>
    <sys:Double x:Key="FontSizeDisplay">28</sys:Double>

    <!-- Four-pixel spacing scale -->
    <sys:Double x:Key="Space1">4</sys:Double>
    <sys:Double x:Key="Space2">8</sys:Double>
    <sys:Double x:Key="Space3">12</sys:Double>
    <sys:Double x:Key="Space4">16</sys:Double>
    <sys:Double x:Key="Space5">20</sys:Double>
    <sys:Double x:Key="Space6">24</sys:Double>
    <sys:Double x:Key="Space8">32</sys:Double>
    <sys:Double x:Key="Space12">48</sys:Double>
    <Thickness x:Key="PagePadding">36,30,36,36</Thickness>
    <Thickness x:Key="CardPadding">24</Thickness>
    <Thickness x:Key="CompactCardPadding">16</Thickness>

    <!-- Shape hierarchy -->
    <CornerRadius x:Key="RadiusXs">4</CornerRadius>
    <CornerRadius x:Key="RadiusChip">7</CornerRadius>
    <CornerRadius x:Key="RadiusSm">8</CornerRadius>
    <CornerRadius x:Key="RadiusControl">10</CornerRadius>
    <CornerRadius x:Key="RadiusCard">18</CornerRadius>
    <CornerRadius x:Key="RadiusFloating">20</CornerRadius>
    <CornerRadius x:Key="RadiusHero">22</CornerRadius>
    <CornerRadius x:Key="RadiusWindow">16</CornerRadius>
    <!-- Reserved for controls whose geometry is intrinsically pill-shaped. -->
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- Motion. App.xaml.cs replaces these with zero when Windows animations are disabled. -->
    <Duration x:Key="MotionInstantDuration">0:0:0.09</Duration>
    <Duration x:Key="MotionFastDuration">0:0:0.14</Duration>
    <Duration x:Key="MotionStandardDuration">0:0:0.22</Duration>
    <Duration x:Key="MotionRelaxedDuration">0:0:0.32</Duration>
    <CubicEase x:Key="MotionEaseOut" EasingMode="EaseOut" />
    <QuadraticEase x:Key="MotionEaseInOut" EasingMode="EaseInOut" />
</ResourceDictionary>
