<UserControl x:Class="MyCO.Manager.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="34,28,34,34" MaxWidth="820">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SettingsTitle}"
                                   FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource SettingsSubtitle}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right"
                            Content="{DynamicResource SaveSettings}"
                            Command="{Binding SaveSettingsCommand}"
                            Style="{StaticResource PrimaryButton}"
                            VerticalAlignment="Top" />
                </DockPanel>

                <Border Margin="0,24,0,0"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="22">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ManagerThemeTitle}"
                                   FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource ManagerThemeDescription}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" Margin="0,7,0,12" />
                        <ComboBox Width="260" HorizontalAlignment="Left"
                                  ItemsSource="{Binding ManagerThemeOptions}"
                                  SelectedItem="{Binding SelectedManagerThemeOption,
                                      Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="{DynamicResource ControlTextBrush}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="22">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource StartupTitle}"
                                   FontSize="17" FontWeight="SemiBold"
                                   Margin="0,0,0,16" />
                        <CheckBox Content="{DynamicResource LaunchAtLogin}"
                                  Style="{StaticResource SwitchCheckBox}"
                                  IsChecked="{Binding LaunchAtLogin}"
                                  Margin="0,0,0,14" />
                        <CheckBox Style="{StaticResource SwitchCheckBox}"
                                  IsChecked="{Binding LaunchCodexOnMycoStart}"
                                  HorizontalContentAlignment="Stretch">
                            <CheckBox.Content>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource LaunchCodexOnStart}" />
                                    <TextBlock Text="{DynamicResource LaunchCodexOnStartDescription}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="12"
                                               LineHeight="18"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </CheckBox.Content>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <Border Margin="0,20,0,0"
                        Background="{DynamicResource ErrorPanelBrush}"
                        BorderBrush="{DynamicResource ErrorBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="{DynamicResource FactoryResetTitle}"
                                       Foreground="{DynamicResource ErrorTextBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource FactoryResetDescription}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="{DynamicResource FactoryResetButton}"
                                Command="{Binding FactoryResetCommand}"
                                Style="{StaticResource DangerButton}"
                                VerticalAlignment="Center"
                                MinWidth="150" />
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
