<!-- Technical, privacy-filtered session diagnostics; no conversation content is shown. -->
<UserControl x:Class="MyCO.Manager.Views.DiagnosticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="34,28,34,34" MaxWidth="900">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel LastChildFill="False">
            <StackPanel>
                <TextBlock Text="{DynamicResource DiagnosticsTitle}" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource DiagnosticsSubtitle}"
                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="{DynamicResource Refresh}"
                    Command="{Binding RefreshDiagnosticsCommand}"
                    Style="{StaticResource PrimaryButton}" Width="108" />
        </DockPanel>
        <!-- At-a-glance connection, runtime, and calibration state -->
        <Grid Grid.Row="1" Margin="0,22,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition />
                <ColumnDefinition Width="12" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardBorder}"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource ConnectionLabel}" FontSize="10"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Text="{Binding ConnectionSummary}" FontWeight="SemiBold"
                               Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2"
                    Style="{StaticResource CardBorder}"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource SkinLabel}" FontSize="10"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Text="{Binding SessionStatus}" FontWeight="SemiBold"
                               Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4"
                    Style="{StaticResource CardBorder}"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource CalibrationLabel}" FontSize="10"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Text="{Binding CalibrationSummary}" FontWeight="SemiBold"
                               Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Grid>
        <!-- Copy-friendly JSON produced only when the user clicks Refresh. -->
        <TextBox Grid.Row="2" Text="{Binding DiagnosticsText}"
                 IsReadOnly="True" AcceptsReturn="True"
                 FontFamily="Cascadia Mono,Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" />
    </Grid>
</UserControl>
