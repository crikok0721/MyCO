<Window x:Class="MyCO.Manager.Views.ResetConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource FactoryResetConfirmTitle}"
        Icon="/MyCO;component/Assets/MyCO.ico"
        Width="620"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{DynamicResource FactoryResetConfirmTitle}"
                       FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource FactoryResetConfirmDescription}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap" LineHeight="20" Margin="0,7,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource ErrorPanelBrush}"
                BorderBrush="{DynamicResource ErrorBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusControl}"
                Padding="16"
                Margin="0,20,0,0">
            <StackPanel>
                <TextBlock Text="{DynamicResource FactoryResetDeletesTitle}"
                           Foreground="{DynamicResource ErrorTextBrush}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource FactoryResetDeletes}"
                           TextWrapping="Wrap" LineHeight="21" Margin="0,7,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Background="{DynamicResource PanelSubtleBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusControl}"
                Padding="16"
                Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="{DynamicResource FactoryResetKeepsTitle}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource FactoryResetKeeps}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap" LineHeight="21" Margin="0,7,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,22,0,0">
            <Button x:Name="CancelButton"
                    Content="{DynamicResource FactoryResetCancel}"
                    IsDefault="True"
                    IsCancel="True"
                    MinWidth="112"
                    Margin="0,0,10,0"
                    Click="Cancel_Click" />
            <Button Content="{DynamicResource FactoryResetConfirmButton}"
                    Style="{StaticResource DangerButton}"
                    MinWidth="150"
                    Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>
