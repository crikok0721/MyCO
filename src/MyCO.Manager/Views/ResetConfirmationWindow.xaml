<Window x:Class="MyCO.Manager.Views.ResetConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource FactoryResetConfirmTitle}"
        Icon="/MyCO;component/Assets/MyCO.ico"
        Width="560"
        MinWidth="480"
        MaxWidth="680"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource WindowBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="16"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource WindowBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusWindow}"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="18,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource FactoryResetConfirmTitle}"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold" />
                    <Button Grid.Column="1"
                            Style="{StaticResource IconButton}"
                            Content="&#xE8BB;"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            FontSize="12"
                            IsCancel="True"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="{DynamicResource ExitMyCO}"
                            Click="Close_Click" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="30,26,30,0">
                <TextBlock Text="{DynamicResource FactoryResetConfirmTitle}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource FactoryResetConfirmDescription}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           LineHeight="20"
                           Margin="0,8,0,0" />
            </StackPanel>

            <Border Grid.Row="2"
                    Style="{StaticResource CardBorder}"
                    Background="{DynamicResource ErrorPanelBrush}"
                    Padding="16"
                    Margin="30,20,30,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource FactoryResetDeletesTitle}"
                               Foreground="{DynamicResource ErrorTextBrush}"
                               FontWeight="SemiBold" />
                    <ItemsControl Margin="0,9,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <TextBlock Text="{DynamicResource FactoryResetDeleteAppearance}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{DynamicResource FactoryResetDeleteCalibration}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{DynamicResource FactoryResetDeleteDiagnostics}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{DynamicResource FactoryResetDeleteStartup}"
                                   TextWrapping="Wrap" />
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Row="3"
                    Style="{StaticResource CardBorder}"
                    Background="{DynamicResource PanelSubtleBrush}"
                    Padding="16"
                    Margin="30,12,30,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource FactoryResetKeepsTitle}"
                               FontWeight="SemiBold" />
                    <StackPanel Margin="0,9,0,0">
                        <TextBlock Text="{DynamicResource FactoryResetKeepProgram}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{DynamicResource FactoryResetKeepCodexProgram}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{DynamicResource FactoryResetKeepCodexData}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="30,22,30,26">
                <Button x:Name="CancelButton"
                        Content="{DynamicResource FactoryResetCancel}"
                        IsDefault="True"
                        IsCancel="True"
                        MinWidth="112"
                        Margin="0,0,10,0"
                        Click="Cancel_Click" />
                <Button Content="{DynamicResource FactoryResetConfirmButton}"
                        Style="{StaticResource DangerButton}"
                        MinWidth="150"
                        Click="Confirm_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
