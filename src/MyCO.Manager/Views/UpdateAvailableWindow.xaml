<Window x:Class="MyCO.Manager.Views.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="520"
        MinWidth="440"
        MaxWidth="620"
        Background="Transparent"
        Title="{DynamicResource UpdateDialogTitle}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="0"
                            CornerRadius="14"
                            GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="{DynamicResource WindowBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" LastChildFill="False">
                <TextBlock Text="{DynamicResource UpdateDialogTitle}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right"
                        Content="×"
                        Click="Close_Click"
                        Style="{StaticResource GhostButton}"
                        ToolTip="{DynamicResource CloseWindow}" />
            </DockPanel>
            <TextBlock Grid.Row="1"
                       Text="{Binding VersionText}"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="0,26,0,0" />
            <TextBlock Grid.Row="2"
                       Text="{Binding DescriptionText}"
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       LineHeight="21"
                       Margin="0,10,0,0" />
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,28,0,0">
                <Button x:Name="LaterButton"
                        Content="{DynamicResource UpdateLater}"
                        Click="Later_Click"
                        IsDefault="True"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="110"
                        Margin="0,0,10,0" />
                <Button Content="{DynamicResource UpdateNow}"
                        Click="UpdateNow_Click"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="130" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
