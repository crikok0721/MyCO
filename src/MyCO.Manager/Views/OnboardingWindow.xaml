<!-- First-run guidance in the same solid, quiet visual language as the Manager shell. -->
<Window x:Class="MyCO.Manager.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource OnboardingWindowTitle}"
        Icon="/MyCO;component/Assets/MyCO.ico"
        Width="640" Height="520"
        MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource WindowBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="16"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootShell"
            Background="{DynamicResource WindowBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusWindow}"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="82" />
            </Grid.RowDefinitions>

            <Border x:Name="OnboardingTitleBar"
                    Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="16,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Width="24" Height="24"
                               Source="/MyCO;component/Assets/MyCO-logo.png"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="{DynamicResource OnboardingWindowTitle}"
                                   Margin="9,0,0,0"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource IconButton}"
                            Content="&#xE8BB;"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            FontSize="12"
                            IsCancel="True"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="{DynamicResource ExitMyCO}"
                            Click="Close_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="36,28,36,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="52" Height="52"
                           Source="/MyCO;component/Assets/MyCO-logo.png"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Margin="18,0,0,0">
                        <TextBlock Text="{DynamicResource OnboardingHeading}"
                                   FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource OnboardingDescription}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="13" LineHeight="20" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        x:Name="OnboardingSteps"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusCard}"
                        Margin="0,24,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource OnboardingStepOne}"
                                   Margin="18,14" TextWrapping="Wrap" />
                        <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" />
                        <TextBlock Grid.Row="2" Text="{DynamicResource OnboardingStepTwo}"
                                   Margin="18,14" TextWrapping="Wrap" />
                        <Border Grid.Row="3" Background="{DynamicResource BorderBrush}" />
                        <TextBlock Grid.Row="4" Text="{DynamicResource OnboardingStepThree}"
                                   Margin="18,14" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,17,0,0">
                    <Ellipse Width="7" Height="7"
                             Fill="{DynamicResource PrimaryBrush}"
                             VerticalAlignment="Center" Margin="0,0,9,0" />
                    <TextBlock Text="{DynamicResource OnboardingPrivacy}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource PanelSubtleBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="36,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource LanguageLabel}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11" Margin="0,0,0,4" />
                        <ComboBox Width="180" HorizontalAlignment="Left"
                                  ItemsSource="{Binding SupportedLanguages}"
                                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="{DynamicResource ControlTextBrush}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="{DynamicResource OnboardingContinue}"
                            Style="{StaticResource PrimaryButton}"
                            MinWidth="140"
                            IsDefault="True"
                            VerticalAlignment="Center"
                            Click="Continue_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
