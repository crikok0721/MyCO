<!-- MyCO home: characters lead; connection and lifecycle controls live in the sidebar dock. -->
<UserControl x:Class="MyCO.Manager.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MyCO.Manager.Controls"
             Style="{StaticResource PageTransitionStyle}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="{StaticResource PagePadding}"
              MaxWidth="1060"
              HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel LastChildFill="False">
                <StackPanel>
                    <TextBlock Text="{DynamicResource HomeTitle}"
                               Style="{StaticResource PageTitleText}" />
                    <TextBlock Text="{DynamicResource HomeSubtitle}"
                               Style="{StaticResource MutedBodyText}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- One primary role surface replaces the former connection dashboard card. -->
            <Border Grid.Row="1"
                    Style="{StaticResource ElevatedCardBorder}"
                    Margin="0,22,0,30">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" MinWidth="430" />
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="0.8*" MinWidth="250" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{DynamicResource HomeCurrentCharacters}"
                                   Style="{StaticResource SectionTitleText}" />

                        <Button Command="{Binding SelectAppearanceCommand}"
                                Style="{StaticResource CharacterButton}"
                                Margin="0,18,0,10"
                                ToolTip="{DynamicResource HomeCharacterEditHint}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="64" Height="64">
                                    <Ellipse Fill="{Binding DarkAvatarBackground}" />
                                    <Ellipse Stroke="{Binding DarkAvatarBorder}"
                                             StrokeThickness="1">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding AssistantAvatar}"
                                                        Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AssistantName}"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{DynamicResource AssistantLabel}"
                                               Style="{StaticResource CaptionText}"
                                               Margin="0,3,0,0" />
                                    <TextBlock Text="{DynamicResource HomeCharacterEditHint}"
                                               Style="{StaticResource CaptionText}"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="&#xE76C;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button Command="{Binding SelectAppearanceCommand}"
                                Style="{StaticResource CharacterButton}"
                                ToolTip="{DynamicResource HomeCharacterEditHint}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="64" Height="64">
                                    <Ellipse Fill="{DynamicResource AvatarPlaceholderBrush}" />
                                    <Ellipse>
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding UserAvatar}"
                                                        Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UserName}"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{DynamicResource UserLabel}"
                                               Style="{StaticResource CaptionText}"
                                               Margin="0,3,0,0" />
                                    <TextBlock Text="{DynamicResource HomeCharacterEditHint}"
                                               Style="{StaticResource CaptionText}"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="&#xE76C;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Width="1"
                            Background="{DynamicResource BorderBrush}"
                            HorizontalAlignment="Center"
                            Margin="0,4" />

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="{DynamicResource HomeAppearanceOverview}"
                                   Style="{StaticResource SectionTitleText}" />

                        <StackPanel Grid.Row="1" Margin="0,18,0,0">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="{DynamicResource HomeTheme}"
                                           Style="{StaticResource CaptionText}" />
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding SelectedManagerThemeOption.DisplayName}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="120" />
                            </DockPanel>
                            <Border Height="1"
                                    Background="{DynamicResource BorderBrush}"
                                    Margin="0,12" />
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="{DynamicResource HomeAppearanceState}"
                                           Style="{StaticResource CaptionText}" />
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding AppearanceStatus}"
                                           FontWeight="SemiBold" />
                            </DockPanel>
                            <Border Height="1"
                                    Background="{DynamicResource BorderBrush}"
                                    Margin="0,12" />
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="{DynamicResource CalibrationLabel}"
                                           Style="{StaticResource CaptionText}" />
                                <TextBlock DockPanel.Dock="Right"
                                           Text="{Binding CalibrationSummary}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="150" />
                            </DockPanel>
                        </StackPanel>

                        <Button Grid.Row="3"
                                Content="{DynamicResource HomeEditAppearance}"
                                Command="{Binding SelectAppearanceCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,22,0,0" />

                        <Grid Grid.Row="4" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="{DynamicResource HomeCalibrate}"
                                    Command="{Binding SelectCalibrationCommand}"
                                    Style="{StaticResource SecondaryButton}" />
                            <Button Grid.Column="2"
                                    Content="{DynamicResource HomeThemeSettings}"
                                    Command="{Binding SelectSettingsCommand}"
                                    Style="{StaticResource GhostButton}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Preview is its own surface; no card-inside-card wrapper. -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="4,0,4,14"
                           LastChildFill="False">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource HomePreviewTitle}"
                                   Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="{DynamicResource HomePreviewSubtitle}"
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right"
                            Content="{DynamicResource HomeEditAppearance}"
                            Command="{Binding SelectAppearanceCommand}"
                            Style="{StaticResource GhostButton}" />
                </DockPanel>
                <controls:ChatPreviewControl Grid.Row="1" />
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
