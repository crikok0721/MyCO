<!-- Premium desktop shell: native window behavior, calm navigation, and state-led content. -->
<Window x:Class="MyCO.Manager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:MyCO.Manager.Views"
        Title="MyCO"
        Icon="/MyCO;component/Assets/MyCO.ico"
        Width="1180"
        Height="800"
        MinWidth="980"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource WindowBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="16"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootShell"
            Background="{DynamicResource WindowBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusWindow}"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <!-- Native-feeling title bar with a compact, truthful connection state. -->
            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="16,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32"
                                CornerRadius="10"
                                Background="{DynamicResource PrimaryMutedBrush}"
                                BorderBrush="{DynamicResource AccentBorderBrush}"
                                BorderThickness="1">
                            <Image Width="25" Height="25"
                                   Source="/MyCO;component/Assets/MyCO-logo.png"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <TextBlock Text="MyCO"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   FontSize="14" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Style="{StaticResource StatusPillBorder}"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,7,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill"
                                                Value="{DynamicResource MutedTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill"
                                                        Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionSummary}"
                                       Style="{StaticResource CaptionText}"
                                       MaxWidth="220"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Width="42" Height="34" MinHeight="34"
                                Padding="0"
                                Style="{StaticResource GhostButton}"
                                ToolTip="{DynamicResource MinimizeWindow}"
                                Click="Minimize_Click">
                            <TextBlock Text="&#xE921;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="10" />
                        </Button>
                        <Button x:Name="MaximizeRestoreButton"
                                Width="42" Height="34" MinHeight="34"
                                Padding="0"
                                Style="{StaticResource GhostButton}"
                                ToolTip="{DynamicResource MaximizeWindow}"
                                Click="MaximizeRestore_Click">
                            <Grid>
                                <TextBlock x:Name="MaximizeGlyph"
                                           Text="&#xE922;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="10" />
                                <TextBlock x:Name="RestoreGlyph"
                                           Text="&#xE923;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="10"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Button>
                        <Button Width="42" Height="34" MinHeight="34"
                                Padding="0"
                                Style="{StaticResource GhostButton}"
                                ToolTip="{DynamicResource ExitMyCO}"
                                Click="Close_Click">
                            <TextBlock Text="&#xE8BB;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="10" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="238" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Navigation stays focused on places; lifecycle actions live on Home. -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SidebarBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid Margin="14,16,14,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <ToggleButton Style="{StaticResource NavToggleButton}"
                                          IsChecked="{Binding IsHomePage, Mode=OneWay}"
                                          Command="{Binding SelectHomeCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="16"
                                               Width="28" />
                                    <TextBlock Text="{DynamicResource NavHome}" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource NavToggleButton}"
                                          IsChecked="{Binding IsAppearancePage, Mode=OneWay}"
                                          Command="{Binding SelectAppearanceCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE790;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="16"
                                               Width="28" />
                                    <TextBlock Text="{DynamicResource NavAppearance}" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource NavToggleButton}"
                                          IsChecked="{Binding IsCalibrationPage, Mode=OneWay}"
                                          Command="{Binding SelectCalibrationCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7C8;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="16"
                                               Width="28" />
                                    <TextBlock Text="{DynamicResource NavCalibration}" />
                                </StackPanel>
                            </ToggleButton>

                            <TextBlock Text="{DynamicResource NavSystem}"
                                       Style="{StaticResource CaptionText}"
                                       FontWeight="SemiBold"
                                       Margin="12,22,0,8" />
                            <ToggleButton Style="{StaticResource NavToggleButton}"
                                          IsChecked="{Binding IsDiagnosticsPage, Mode=OneWay}"
                                          Command="{Binding SelectDiagnosticsCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="16"
                                               Width="28" />
                                    <TextBlock Text="{DynamicResource NavDiagnostics}" />
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <Border Style="{StaticResource SidebarDockBorder}"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="{DynamicResource HomePluginStatus}"
                                                   Style="{StaticResource CaptionText}"
                                                   FontWeight="SemiBold" />
                                        <Border DockPanel.Dock="Right"
                                                Width="8"
                                                Height="8"
                                                CornerRadius="{StaticResource RadiusXs}"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource MutedTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsConnected}"
                                                                     Value="True">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Text="{Binding ConnectionSummary}"
                                               FontWeight="SemiBold"
                                               Margin="0,6,0,13"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{DynamicResource HomeTarget}"
                                               Style="{StaticResource CaptionText}"
                                               Margin="0,0,0,6" />
                                    <TextBlock FontWeight="SemiBold"
                                               Margin="0,0,0,8"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Text"
                                                        Value="{DynamicResource HomeNoTarget}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSelectedCandidate}"
                                                                 Value="True">
                                                        <Setter Property="Text"
                                                                Value="{Binding SelectedCandidate.DisplayName}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ComboBox ItemsSource="{Binding Candidates}"
                                              SelectedItem="{Binding SelectedCandidate}"
                                              MinHeight="36"
                                              Margin="0,0,0,10">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Foreground="{DynamicResource ControlTextBrush}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Grid>
                                        <Button Content="{DynamicResource DetectAgain}"
                                                Command="{Binding DetectCommand}"
                                                Style="{StaticResource PrimaryButton}"
                                                MinHeight="36"
                                                Visibility="{Binding ShowDetectAction,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Button Content="{DynamicResource StartWithMyCO}"
                                                Command="{Binding StartCommand}"
                                                Style="{StaticResource PrimaryButton}"
                                                MinHeight="36"
                                                Visibility="{Binding ShowStartAction,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Button Content="{DynamicResource Enable}"
                                                Command="{Binding EnableCommand}"
                                                Style="{StaticResource PrimaryButton}"
                                                MinHeight="36"
                                                Visibility="{Binding ShowEnableAction,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Button Content="{DynamicResource Disable}"
                                                Command="{Binding DisableCommand}"
                                                Style="{StaticResource PrimaryButton}"
                                                MinHeight="36"
                                                Visibility="{Binding ShowDisableAction,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                    <Button Content="{DynamicResource TrayRestartCodex}"
                                            Command="{Binding RestartCommand}"
                                            Style="{StaticResource GhostButton}"
                                            MinHeight="32"
                                            Margin="0,5,0,0"
                                            Visibility="{Binding ShowRestartAction,
                                                Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>

                            <ToggleButton Style="{StaticResource NavToggleButton}"
                                          IsChecked="{Binding IsSettingsPage, Mode=OneWay}"
                                          Command="{Binding SelectSettingsCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="16"
                                               Width="28" />
                                    <TextBlock Text="{DynamicResource NavSettings}" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource NavToggleButton}"
                                          IsChecked="{Binding IsAboutPage, Mode=OneWay}"
                                          Command="{Binding SelectAboutCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="16"
                                               Width="28" />
                                    <TextBlock Text="{DynamicResource NavAbout}" />
                                </StackPanel>
                            </ToggleButton>

                            <TextBlock Text="{DynamicResource LanguageLabel}"
                                       Style="{StaticResource CaptionText}"
                                       FontWeight="SemiBold"
                                       Margin="12,13,0,6" />
                            <ComboBox ItemsSource="{Binding SupportedLanguages}"
                                      SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{DynamicResource ControlTextBrush}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Pages remain constructed so in-progress appearance edits are preserved. -->
                <Grid Grid.Column="1" Background="{DynamicResource WindowBrush}">
                    <views:HomePage Visibility="{Binding IsHomePage,
                        Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <views:AppearancePage Style="{StaticResource PageTransitionStyle}"
                                          Visibility="{Binding IsAppearancePage,
                        Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <views:CalibrationPage Style="{StaticResource PageTransitionStyle}"
                                           Visibility="{Binding IsCalibrationPage,
                        Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <views:DiagnosticsPage Style="{StaticResource PageTransitionStyle}"
                                           Visibility="{Binding IsDiagnosticsPage,
                        Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <views:AboutPage Style="{StaticResource PageTransitionStyle}"
                                     Visibility="{Binding IsAboutPage,
                        Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <views:SettingsPage Style="{StaticResource PageTransitionStyle}"
                                        Visibility="{Binding IsSettingsPage,
                        Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Grid>

            <!-- Persistent operation feedback; color never carries meaning alone. -->
            <Border Grid.Row="2"
                    Background="{DynamicResource StatusBarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="6" Height="6"
                             Fill="{DynamicResource PrimaryBrush}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Status}"
                               Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2"
                               Text="{DynamicResource LocalOnlyStatus}"
                               Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
