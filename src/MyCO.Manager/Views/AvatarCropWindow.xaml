<Window x:Class="MyCO.Manager.Views.AvatarCropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AvatarCropTitle}"
        Icon="/MyCO;component/Assets/MyCO.ico"
        Width="470"
        Height="600"
        MinWidth="430"
        MinHeight="560"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}"
        UseLayoutRounding="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="360" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="22" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource AvatarCropTitle}"
                   FontSize="20"
                   FontWeight="SemiBold" />

        <Grid x:Name="CropViewport"
              Grid.Row="2"
              Width="360"
              Height="360"
              HorizontalAlignment="Center"
              ClipToBounds="True"
              Background="{DynamicResource ControlBrush}"
              MouseLeftButtonDown="CropViewport_MouseLeftButtonDown"
              MouseMove="CropViewport_MouseMove"
              MouseLeftButtonUp="CropViewport_MouseLeftButtonUp"
              MouseWheel="CropViewport_MouseWheel">
            <Canvas x:Name="ImageCanvas"
                    Width="360"
                    Height="360"
                    IsHitTestVisible="False">
                <Image x:Name="SourceImage"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ImageScale" />
                            <TranslateTransform x:Name="ImageTranslate" />
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
            </Canvas>
            <Path x:Name="CropMask"
                  IsHitTestVisible="False"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Fill="{DynamicResource OverlayBrush}" />
            <Ellipse x:Name="CropOutline"
                     IsHitTestVisible="False"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Stroke="{DynamicResource PrimaryBrush}"
                     StrokeThickness="2" />
        </Grid>

        <Grid Grid.Row="4" HorizontalAlignment="Center" Width="360">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="−"
                    ToolTip="{DynamicResource AvatarCropZoomOut}"
                    Style="{StaticResource IconButton}"
                    Width="36"
                    Height="36"
                    Click="ZoomOut_Click" />
            <Slider x:Name="ZoomSlider"
                    Grid.Column="1"
                    Minimum="1"
                    Maximum="4"
                    Value="1"
                    Margin="12,0"
                    VerticalAlignment="Center" />
            <Button Grid.Column="2"
                    Content="＋"
                    ToolTip="{DynamicResource AvatarCropZoomIn}"
                    Style="{StaticResource IconButton}"
                    Width="36"
                    Height="36"
                    Click="ZoomIn_Click" />
        </Grid>

        <TextBlock Grid.Row="5"
                   x:Name="ZoomLabel"
                   Text="100%"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource MutedTextBrush}" />

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="{DynamicResource AvatarCropConfirm}"
                    Style="{StaticResource PrimaryButton}"
                    IsDefault="True"
                    MinWidth="108"
                    Margin="0,0,8,0"
                    Click="Confirm_Click" />
            <Button Content="{DynamicResource AvatarCropCancel}"
                    Style="{StaticResource SecondaryButton}"
                    IsCancel="True"
                    MinWidth="108"
                    Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
