{
  "name": "@myco/runtime",
  "version": "0.99.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:test": "tsc -p tsconfig.test.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build:test && node --import ./.test-dist/tests/setup.js --test .test-dist/tests/*.test.js",
    "check": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/node": "26.1.2",
    "esbuild": "0.28.1",
    "jsdom": "30.0.1",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
