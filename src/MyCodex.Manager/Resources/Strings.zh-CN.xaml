    <sys:String x:Key="AvatarSizeFormat">头像大小 · {0:F0}px</sys:String>
    <sys:String x:Key="BubbleRadiusFormat">气泡圆角 · {0:F0}px</sys:String>
    <sys:String x:Key="MessageGapFormat">消息间距 · {0:F0}px</sys:String>
