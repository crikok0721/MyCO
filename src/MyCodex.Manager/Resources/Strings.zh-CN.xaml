    <sys:String x:Key="SkinLabel">皮肤</sys:String>
    <sys:String x:Key="CalibrationLabel">校准</sys:String>
    <sys:String x:Key="DiagnosticsNotRefreshed">诊断信息尚未刷新。</sys:String>
