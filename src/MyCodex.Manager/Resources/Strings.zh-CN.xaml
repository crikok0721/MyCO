    <sys:String x:Key="ShowNicknames">显示昵称</sys:String>

    <sys:String x:Key="CalibrationTitle">校准</sys:String>
    <sys:String x:Key="CalibrationSubtitle">教 MyCodex 识别当前渲染器结构，且不保存聊天正文。</sys:String>
    <sys:String x:Key="CurrentSignatureState">当前结构签名状态</sys:String>
    <sys:String x:Key="SignatureDescription">签名包含标签名、角色、稳定语义属性、祖先结构、布局比例和能力。绝不会保存消息正文。</sys:String>
    <sys:String x:Key="SelectAssistantTurn">选择一条助手回复</sys:String>
    <sys:String x:Key="SelectAssistantDescription">请选择外层回复容器，不要选择代码块、Diff、状态行或工具栏。</sys:String>
    <sys:String x:Key="CalibrateAssistant">校准助手消息</sys:String>
    <sys:String x:Key="SelectUserTurn">选择一条用户消息</sys:String>
    <sys:String x:Key="SelectUserDescription">请选择一条普通用户消息。在 Codex 中按 Escape 可取消且不会更改设置。</sys:String>
    <sys:String x:Key="CalibrateUser">校准用户消息</sys:String>
    <sys:String x:Key="FailClosed">安全失败</sys:String>
    <sys:String x:Key="FailClosedDescription">低置信度会判为未知并保持原样。少一个气泡也比破坏 Codex 原生控件更安全。</sys:String>
    <sys:String x:Key="CalibrationSummaryFormat">助手：{0}  ·  用户：{1}</sys:String>
    <sys:String x:Key="CalibrationReady">已就绪</sys:String>
    <sys:String x:Key="CalibrationNotCalibrated">未校准</sys:String>

    <sys:String x:Key="DiagnosticsTitle">诊断</sys:String>
