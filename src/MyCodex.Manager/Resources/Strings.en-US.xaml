    <sys:String x:Key="AboutTitle">About MyCodex</sys:String>
    <sys:String x:Key="AboutSubtitle">Independent local UI customization for Codex / ChatGPT Desktop</sys:String>
    <sys:String x:Key="AboutTagline">Manager + CDP Runtime Injector + DOM Skin Engine</sys:String>
    <sys:String x:Key="PrivacyByConstruction">Privacy by construction</sys:String>
    <sys:String x:Key="PrivacyParagraphOne">MyCodex runs locally. It does not upload conversations, require OpenAI credentials, collect telemetry, read authentication cookies, intercept network requests, or expose shell/file privileges to injected JavaScript.</sys:String>
    <sys:String x:Key="PrivacyParagraphTwo">Configuration, avatar copies, structural calibration signatures, backups, and privacy-safe logs are stored under %APPDATA%\MyCodex.</sys:String>
    <sys:String x:Key="OpenConfigFolder">Open local configuration folder</sys:String>
    <sys:String x:Key="CompatibilityTitle">Compatibility</sys:String>
    <sys:String x:Key="CompatibilityParagraph">Automatic capability detection handles small changes. Recalibration handles structural changes. Major renderer or CDP changes may require a new MyCodex release. Compatibility with every future update is not guaranteed.</sys:String>
    <sys:String x:Key="LicenseDisclaimer">License &amp; disclaimer</sys:String>
    <sys:String x:Key="LicenseCopyright">MIT License · Copyright © 2026 MyCodex Contributors</sys:String>
    <sys:String x:Key="DisclaimerParagraph">MyCodex is an independent open-source project. It is not affiliated with, endorsed by, or sponsored by OpenAI. An official Codex / ChatGPT Desktop installation is required.</sys:String>

    <sys:String x:Key="OnboardingWindowTitle">Welcome to MyCodex</sys:String>
    <sys:String x:Key="OnboardingHeading">Make Codex feel like your chat</sys:String>
    <sys:String x:Key="OnboardingDescription">MyCodex adds local avatars, nicknames, and compact chat bubbles while preserving native code, diff, tool, approval, and toolbar UI.</sys:String>
    <sys:String x:Key="OnboardingStepOne">1   Select the detected official Desktop app</sys:String>
    <sys:String x:Key="OnboardingStepTwo">2   Choose avatars and nicknames in Appearance</sys:String>
    <sys:String x:Key="OnboardingStepThree">3   Start Codex with MyCodex, then calibrate one user and assistant turn</sys:String>
    <sys:String x:Key="OnboardingPrivacy">Everything runs locally. No telemetry, credentials, cookies, or network interception.</sys:String>
    <sys:String x:Key="OnboardingContinue">Continue to MyCodex</sys:String>

