<!-- Appearance editor with live preview, identities, and geometry controls. -->
<UserControl x:Class="MyCodex.Manager.Views.AppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="34,28,34,34" MaxWidth="900" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel>
                <StackPanel>
                    <TextBlock Text="{DynamicResource AppearanceTitle}" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource AppearanceSubtitle}"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="{DynamicResource Reset}" Command="{Binding ResetAppearanceCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="{DynamicResource SaveApply}" Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </DockPanel>

            <!-- The preview uses the same bound values that are saved to AppConfig. -->
            <Border Grid.Row="1" Margin="0,24,0,18" Padding="26"
                    Background="#141517" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource LivePreview}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <Grid Margin="0,24,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="{Binding AvatarSize}" Height="{Binding AvatarSize}"
                                  VerticalAlignment="Top">
                                <Grid.RenderTransform>
                                    <TranslateTransform X="{Binding AvatarOffsetX}"
                                                        Y="{Binding AvatarOffsetY}" />
                                </Grid.RenderTransform>
                                <Ellipse Fill="#2A2D33" />
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding AssistantAvatar}"
                                                    Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="12,-2,0,0">
                                <TextBlock Text="{Binding AssistantName}"
                                           Visibility="{Binding NicknameVisible,
                                             Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Foreground="#969AA3" FontSize="13" Margin="1,0,0,5" />
                                <Border Background="{Binding AssistantBubble}"
                                        CornerRadius="{Binding BubbleRadius}"
                                        Padding="{Binding BubblePaddingX}">
                                    <TextBlock Text="{DynamicResource PreviewAssistant}"
                                               TextWrapping="Wrap" MaxWidth="450" />
                                </Border>
                                <Border Background="#101114" BorderBrush="#343740"
                                        BorderThickness="1" CornerRadius="8" Padding="12"
                                        Margin="0,10,0,0" MaxWidth="520"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="{DynamicResource PreviewToolCard}"
                                               FontFamily="Consolas" Foreground="#A8ADB8" />
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2" HorizontalAlignment="Right">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel HorizontalAlignment="Right" Margin="0,-2,12,0">
                                <TextBlock Text="{Binding UserName}" TextAlignment="Right"
                                           Visibility="{Binding NicknameVisible,
                                             Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Foreground="#969AA3" FontSize="13" Margin="0,0,1,5" />
                                <Border Background="#242424"
                                        CornerRadius="16"
                                        Padding="12,8"
                                        HorizontalAlignment="Right">
                                    <TextBlock Text="{DynamicResource PreviewUser}" />
                                </Border>
                            </StackPanel>
                            <Grid Grid.Column="1" Width="{Binding AvatarSize}"
                                  Height="{Binding AvatarSize}" VerticalAlignment="Top">
                                <Grid.RenderTransform>
                                    <TranslateTransform X="{Binding UserAvatarOffsetX}"
                                                        Y="{Binding AvatarOffsetY}" />
                                </Grid.RenderTransform>
                                <Ellipse Fill="#2A2D33" />
                                <Ellipse>
                                    <Ellipse.Fill>
                                        <ImageBrush ImageSource="{Binding UserAvatar}"
                                                    Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Assistant and user identity settings -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource AssistantLabel}" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="{DynamicResource Nickname}" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11" Margin="0,18,0,6" />
                        <TextBox Text="{Binding AssistantName, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="{DynamicResource ChooseAssistantAvatar}"
                                Command="{Binding PickAssistantAvatarCommand}"
                                Margin="0,12,0,0" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding AssistantAvatar}" FontSize="10"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource UserLabel}" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="{DynamicResource Nickname}" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11" Margin="0,18,0,6" />
                        <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="{DynamicResource ChooseUserAvatar}"
                                Command="{Binding PickUserAvatarCommand}"
                                Margin="0,12,0,0" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding UserAvatar}" FontSize="10"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Numeric controls are constrained to ranges validated by ConfigStore. -->
            <Border Grid.Row="3" Margin="0,18,0,0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Geometry}" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="{Binding AvatarSizeLabel}"
                                   Margin="0,17,0,3" />
                        <Slider Minimum="24" Maximum="72" Value="{Binding AvatarSize}" />
                        <TextBlock Text="{Binding AvatarOffsetXLabel}"
                                   Margin="0,13,0,3" />
                        <Slider Minimum="-32" Maximum="32" Value="{Binding AvatarOffsetX}" />
                        <TextBlock Text="{Binding AvatarOffsetYLabel}"
                                   Margin="0,13,0,3" />
                        <Slider Minimum="-20" Maximum="40" Value="{Binding AvatarOffsetY}" />
                        <TextBlock Text="{Binding BubbleRadiusLabel}"
                                   Margin="0,13,0,3" />
                        <Slider Minimum="0" Maximum="30" Value="{Binding BubbleRadius}" />
                        <TextBlock Text="{Binding MessageGapLabel}"
                                   Margin="0,13,0,3" />
                        <Slider Minimum="8" Maximum="64" Value="{Binding MessageGap}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource BubbleBehavior}" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="{Binding BubblePaddingXLabel}"
                                   Margin="0,17,0,3" />
                        <Slider Minimum="6" Maximum="28" Value="{Binding BubblePaddingX}" />
                        <TextBlock Text="{Binding BubblePaddingYLabel}"
                                   Margin="0,13,0,3" />
                        <Slider Minimum="6" Maximum="22" Value="{Binding BubblePaddingY}" />
                        <TextBlock Text="{Binding MessageMaxWidthLabel}"
                                   Margin="0,13,0,3" />
                        <Slider Minimum="45" Maximum="80" Value="{Binding MessageMaxWidth}" />
                        <CheckBox Content="{DynamicResource ShowNicknames}" IsChecked="{Binding NicknameVisible}"
                                  Margin="0,16,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
