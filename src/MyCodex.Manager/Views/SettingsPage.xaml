<UserControl x:Class="MyCodex.Manager.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="34,28,34,34" MaxWidth="820">
            <StackPanel>
                <DockPanel>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SettingsTitle}"
                                   FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource SettingsSubtitle}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                    <Button DockPanel.Dock="Right"
                            Content="{DynamicResource SaveSettings}"
                            Command="{Binding SaveSettingsCommand}"
                            Style="{StaticResource PrimaryButton}"
                            VerticalAlignment="Top" />
                </DockPanel>

                <Border Margin="0,24,0,0"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="22">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ManagerThemeTitle}"
                                   FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource ManagerThemeDescription}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" Margin="0,7,0,12" />
                        <ComboBox Width="260" HorizontalAlignment="Left"
                                  ItemsSource="{Binding ManagerThemeOptions}"
                                  SelectedItem="{Binding SelectedManagerThemeOption,
                                      Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"
                                               Foreground="{DynamicResource ControlTextBrush}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="22">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource StartupTitle}"
                                   FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource StartupDescription}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" Margin="0,7,0,16" />
                        <CheckBox Content="{DynamicResource LaunchAtLogin}"
                                  IsChecked="{Binding LaunchAtLogin}"
                                  Margin="0,0,0,12" />
                        <TextBlock Text="{DynamicResource LaunchAtLoginDescription}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" Margin="24,-7,0,15" />
                        <CheckBox Content="{DynamicResource LaunchCodexOnStart}"
                                  IsChecked="{Binding LaunchCodexOnMyCodexStart}" />
                        <TextBlock Text="{DynamicResource LaunchCodexOnStartDescription}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" Margin="24,5,0,0" />
                    </StackPanel>
                </Border>

                <Border Margin="0,16,0,0"
                        Background="{DynamicResource SuccessPanelBrush}"
                        BorderBrush="{DynamicResource SuccessBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="16">
                    <TextBlock Text="{DynamicResource StartupSafetyNote}"
                               Foreground="{DynamicResource SuccessTextBrush}"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
