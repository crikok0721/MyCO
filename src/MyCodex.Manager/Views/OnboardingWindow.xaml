<!-- First-run guidance and language picker shown before the main window. -->
<Window x:Class="MyCodex.Manager.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource OnboardingWindowTitle}"
        Width="620" Height="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBrush}">
    <Grid Margin="38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <Border Width="58" Height="58" CornerRadius="17"
                    Background="{DynamicResource PrimaryBrush}"
                    HorizontalAlignment="Left">
                <Grid>
                    <Path Data="M9,11 H49 V39 H31 L21,48 V39 H9 Z"
                          Stroke="White" StrokeThickness="2" Fill="Transparent" />
                    <TextBlock Text="M" FontSize="21" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <TextBlock Text="{DynamicResource OnboardingHeading}"
                       FontSize="28" FontWeight="SemiBold" Margin="0,22,0,0" />
            <TextBlock Text="{DynamicResource OnboardingDescription}"
                       TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="14" LineHeight="22" Margin="0,9,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,30,0,0">
            <TextBlock Text="{DynamicResource OnboardingStepOne}"
                       FontWeight="SemiBold" Margin="0,0,0,12" />
            <TextBlock Text="{DynamicResource OnboardingStepTwo}"
                       FontWeight="SemiBold" Margin="0,0,0,12" />
            <TextBlock Text="{DynamicResource OnboardingStepThree}"
                       FontWeight="SemiBold" />
            <Border Background="{DynamicResource SuccessPanelBrush}"
                    BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1"
                    CornerRadius="9" Padding="14" Margin="0,24,0,0">
                <TextBlock Text="{DynamicResource OnboardingPrivacy}"
                           Foreground="{DynamicResource SuccessTextBrush}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Bottom">
                <TextBlock Text="{DynamicResource LanguageLabel}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="10" FontWeight="SemiBold" Margin="0,0,0,5" />
                <ComboBox Width="170" HorizontalAlignment="Left"
                          ItemsSource="{Binding SupportedLanguages}"
                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}"
                                       Foreground="{DynamicResource ControlTextBrush}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
            <Button Grid.Column="1" Content="{DynamicResource OnboardingContinue}"
                    Style="{StaticResource PrimaryButton}"
                    VerticalAlignment="Bottom" Click="Continue_Click" />
        </Grid>
    </Grid>
</Window>
