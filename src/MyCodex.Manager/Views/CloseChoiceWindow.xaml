<Window x:Class="MyCodex.Manager.Views.CloseChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource CloseChoiceTitle}"
        Icon="/Assets/mycodex.ico"
        Width="480" Height="230"
        MinWidth="440"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Image Source="/Assets/mycodex.ico"
                   Width="44" Height="44"
                   Margin="0,0,14,0" />
            <StackPanel>
                <TextBlock Text="{DynamicResource CloseChoiceTitle}"
                           FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource CloseChoiceDescription}"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           MaxWidth="350"
                           Margin="0,6,0,0" />
            </StackPanel>
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button Content="{DynamicResource CloseChoiceExit}"
                    Click="Exit_Click"
                    Margin="0,0,6,0" />
            <Button Grid.Column="1"
                    Content="{DynamicResource CloseChoiceMinimize}"
                    Click="Minimize_Click"
                    Style="{StaticResource PrimaryButton}"
                    Margin="3,0" />
            <Button Grid.Column="2"
                    Content="{DynamicResource CloseChoiceCancel}"
                    Click="Cancel_Click"
                    Margin="6,0,0,0" />
        </Grid>
    </Grid>
</Window>
