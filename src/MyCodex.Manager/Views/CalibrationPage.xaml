<UserControl x:Class="MyCodex.Manager.Views.CalibrationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="34,28,34,34" MaxWidth="900">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource CalibrationTitle}" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource CalibrationSubtitle}"
                           Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
            </StackPanel>

            <Border Grid.Row="1" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="22" Margin="0,24,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="17" Background="#252235"
                            VerticalAlignment="Top">
                        <TextBlock Text="⌖" FontSize="17" Foreground="#B8AFFA"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{DynamicResource CurrentSignatureState}" FontWeight="SemiBold"
                                   FontSize="16" />
                        <TextBlock Text="{Binding CalibrationSummary}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,7,0,0" />
                        <TextBlock Text="{DynamicResource SignatureDescription}"
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Background="#17191D" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="22">
                    <StackPanel>
                        <TextBlock Text="1" Foreground="#B8AFFA" FontWeight="Bold" />
                        <TextBlock Text="{DynamicResource SelectAssistantTurn}" FontSize="17"
                                   FontWeight="SemiBold" Margin="0,9,0,0" />
                        <TextBlock Text="{DynamicResource SelectAssistantDescription}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" Margin="0,8,0,18" />
                        <Button Content="{DynamicResource CalibrateAssistant}"
                                Command="{Binding CalibrateAssistantCommand}"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#17191D"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="22">
                    <StackPanel>
                        <TextBlock Text="2" Foreground="#B8AFFA" FontWeight="Bold" />
                        <TextBlock Text="{DynamicResource SelectUserTurn}" FontSize="17"
                                   FontWeight="SemiBold" Margin="0,9,0,0" />
                        <TextBlock Text="{DynamicResource SelectUserDescription}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" Margin="0,8,0,18" />
                        <Button Content="{DynamicResource CalibrateUser}"
                                Command="{Binding CalibrateUserCommand}"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
                <Border Grid.ColumnSpan="3" Margin="0,230,0,0" Padding="18"
                        Background="#181B19" BorderBrush="#294233"
                        BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource FailClosed}" Foreground="#75D8A1"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource FailClosedDescription}"
                                   Foreground="#9EB6A8" TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
