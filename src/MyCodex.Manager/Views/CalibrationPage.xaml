<!-- Two-step renderer calibration workflow for assistant and user turn signatures. -->
<UserControl x:Class="MyCodex.Manager.Views.CalibrationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="34,28,34,34" MaxWidth="900">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource CalibrationTitle}" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource CalibrationSubtitle}"
                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0" />
            </StackPanel>

            <!-- Read-only summary of the signatures currently stored in config. -->
            <Border Grid.Row="1" Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="22" Margin="0,24,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="17"
                            Background="{DynamicResource PrimaryMutedBrush}"
                            VerticalAlignment="Top">
                        <TextBlock Text="⌖" FontSize="17"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{DynamicResource CurrentSignatureState}" FontWeight="SemiBold"
                                   FontSize="16" />
                        <TextBlock Text="{Binding CalibrationSummary}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,7,0,0" />
                        <TextBlock Text="{DynamicResource SignatureDescription}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Each command asks the user to select one visible turn in the desktop app. -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource PanelSubtleBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="22">
                    <StackPanel>
                        <TextBlock Text="1" Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontWeight="Bold" />
                        <TextBlock Text="{DynamicResource SelectAssistantTurn}" FontSize="17"
                                   FontWeight="SemiBold" Margin="0,9,0,0" />
                        <TextBlock Text="{DynamicResource SelectAssistantDescription}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" Margin="0,8,0,18" />
                        <Button Content="{DynamicResource CalibrateAssistant}"
                                Command="{Binding CalibrateAssistantCommand}"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource PanelSubtleBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="22">
                    <StackPanel>
                        <TextBlock Text="2" Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontWeight="Bold" />
                        <TextBlock Text="{DynamicResource SelectUserTurn}" FontSize="17"
                                   FontWeight="SemiBold" Margin="0,9,0,0" />
                        <TextBlock Text="{DynamicResource SelectUserDescription}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" Margin="0,8,0,18" />
                        <Button Content="{DynamicResource CalibrateUser}"
                                Command="{Binding CalibrateUserCommand}"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
                <Border Grid.ColumnSpan="3" Margin="0,230,0,0" Padding="18"
                        Background="{DynamicResource SuccessPanelBrush}"
                        BorderBrush="{DynamicResource SuccessBorderBrush}"
                        BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource FailClosed}"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource FailClosedDescription}"
                                   Foreground="{DynamicResource SuccessTextBrush}"
                                   TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
